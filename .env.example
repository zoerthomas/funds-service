PORT=3000

DB_PATH=funds.db

# {code} is replaced with each fund code at fetch time
FUND_SOURCE_URL=https://cdn.core3-dev.ajbbuild.uk/interview/{code}.json

# Comma-separated list of fund codes to fetch
FUND_CODES=BYW8RV9,BYW8RX1,BYW8VG2,BN0S2V9

# Refresh schedule (cron syntax) - default: every day at 12:05
REFRESH_CRON=05 12 * * *

# Per-request timeout when fetching a fund, in milliseconds - default: 10000
FETCH_TIMEOUT_MS=10000
